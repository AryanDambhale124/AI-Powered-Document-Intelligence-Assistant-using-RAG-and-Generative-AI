rules_version = '2';
// Public no-login demo: the browser never talks to Firestore directly.
// All reads/writes go through Cloud Functions (Admin SDK bypasses these rules),
// which scope every record to a private per-browser session ID and enforce quotas.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
